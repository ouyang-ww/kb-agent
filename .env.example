# 复制为 .env 并填写你的配置（也可直接用环境变量，前缀 KB_）

# ---- 存储 ----
KB_STORAGE_DIR=~/.kbagent
KB_DEFAULT_COLLECTION=personal

# ---- 存储后端（见 docs/adr/0001-storage.md）----
KB_VECTOR_STORE=chroma
KB_DOC_STORE=sqlite
# 向量度量需与嵌入模型一致；默认 l2 兼容旧索引，bge 系列可评估 cosine
KB_VECTOR_METRIC=l2
# 留空则自动由模型名 + 切块版本派生，如 baai-bge-small-zh-v1-5@c1
KB_EMBEDDING_MANIFEST_ID=
KB_CHUNKER_VERSION=c1

# ---- 学习扩展默认值（可选；运行时可 kb config set 热切换）----
KB_STUDY_ENABLED=false
KB_STUDY_CONCEPTS=true
KB_STUDY_ITEMS=true
KB_STUDY_QUEUE=true
KB_STUDY_WEEKLY=true
KB_STUDY_DASHBOARD=true
KB_STUDY_NOTIFICATIONS=false
KB_DEFAULT_SCOPE=default

# ---- 网络 ----
# 忽略失效的 http_proxy/https_proxy（直连 LLM/HF，防止代理卡死）；需要代理时设 false
KB_IGNORE_HTTP_PROXY=true

# ---- 嵌入（本地 CPU 模型）----
KB_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
# 国内网络可先设置: export HF_ENDPOINT=https://hf-mirror.com
KB_EMBEDDING_QUERY_INSTRUCTION=为这个句子生成表示以用于检索相关文章：
KB_EMBEDDING_BATCH_SIZE=32

# ---- 切块 ----
KB_CHUNK_SIZE=800
KB_CHUNK_OVERLAP=100

# ---- 重排 ----
KB_RERANK_ENABLED=true
KB_RERANK_MODEL=BAAI/bge-reranker-base
KB_RERANK_CANDIDATES=20
KB_TOP_K=5

# ---- 意图识别 / 查询改写 ----
KB_INTENT_ENABLED=true
KB_QUERY_REWRITE_ENABLED=true
KB_MAX_PARENT_CHARS=4000
KB_PARENT_MODE=full

# ---- LLM（任意 OpenAI 兼容服务）----
KB_LLM_BASE_URL=https://api.deepseek.com/v1
KB_LLM_MODEL=deepseek-chat
KB_LLM_API_KEY=
KB_LLM_TEMPERATURE=0.2
KB_LLM_MAX_TOKENS=1024

# ---- 多模态（图片）----
KB_MULTIMODAL_ENABLED=true
# 图片描述模型：留空则用 KB_LLM_MODEL（需支持图片输入，否则降级为仅存图片不描述）
KB_IMAGE_CAPTION_MODEL=
# 图片解读模型（生成答案时看图）：留空则仅用描述文本
KB_VISION_LLM_MODEL=
KB_VISION_LLM_BASE_URL=
KB_OCR_ENABLED=false

# ---- 评估 ----
KB_EVAL_JUDGE_MODEL=

# ---- 服务 ----
KB_API_HOST=127.0.0.1
KB_API_PORT=8710
KB_API_KEY=
KB_UI_PORT=7860
